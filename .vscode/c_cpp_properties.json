          "${workspaceFolder}/firmware/common/include",
          "${workspaceFolder}/firmware/common/src",
          "${workspaceFolder}/firmware/target",
          "${workspaceFolder}/tests"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ],
  "version": 4,
  "enableConfigurationSquiggles": true
}